generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum FacilityType {
  BLOOD_BANK
  LABORATORY
  HOSPITAL
  MOBILE_DONATION
  OTHER
}

enum FacilityStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum DonationState {
  SCHEDULED
  CHECKED_IN
  COLLECTED
  SCREENING
  QUARANTINED
  RELEASED
  REJECTED
  CANCELLED
  COMPLETED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
}

enum ScreeningResult {
  IN_PROGRESS
  PASS
  REJECT
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntilAt    DateTime?
  name             String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditEvents             AuditEvent[]
  userRoles               UserRole[]
  memberships             FacilityMembership[]
  assignedUserRoles       UserRole[]               @relation("UserRoleAssignedBy")
  assignedMemberships     FacilityMembership[]     @relation("FacilityMembershipAssignedBy")

  donorProfile            DonorProfile?
  bloodDrivesCreated      BloodDrive[]           @relation("BloodDriveCreatedBy")
  registrationsRegistered CampaignRegistration[] @relation("RegistrationRegisteredBy")
  donationsCreated        Donation[]             @relation("DonationCreatedBy")
  screeningsPerformed     DonationScreening[]    @relation("ScreeningScreenedBy")
  deferralsCreated        DonorDeferral[]        @relation("DeferralCreatedBy")
  deferralsResolved       DonorDeferral[]        @relation("DeferralResolvedBy")
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  csrfTokenHash String
  rotatedFromId String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  ipAddress     String?
  userAgent     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditEvent {
  id             String   @id @default(uuid())
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  organizationId String?
  facilityId     String?
  requestId      String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  occurredAt     DateTime @default(now())
  prevHash       String?
  hash           String

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([organizationId])
  @@index([facilityId])
  @@index([occurredAt])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  category    String
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model Role {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String
  isSystem    Boolean   @default(true)
  scope       RoleScope @default(FACILITY)
  createdAt   DateTime  @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  memberships     FacilityMembership[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  code         String             @unique
  status       OrganizationStatus @default(ACTIVE)
  contactEmail String?
  contactPhone String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  facilities Facility[]

  @@index([status])
}

model Facility {
  id             String         @id @default(uuid())
  organizationId String
  code           String         @unique
  name           String
  type           FacilityType
  status         FacilityStatus @default(PENDING)
  contactEmail   String?
  contactPhone   String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  FacilityMembership[]

  bloodDrives BloodDrive[]
  donations   Donation[]

  @@index([organizationId])
  @@index([status])
}

model FacilityMembership {
  id           String           @id @default(uuid())
  userId       String
  facilityId   String
  roleId       String
  status       MembershipStatus @default(ACTIVE)
  assignedById String?
  assignedAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("FacilityMembershipAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, facilityId, roleId])
  @@index([facilityId])
  @@index([userId])
}

model DonorProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  publicCode  String      @unique
  name        String
  dateOfBirth DateTime?
  bloodGroup  BloodGroup?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations     Donation[]
  registrations CampaignRegistration[]
  deferrals     DonorDeferral[]

  @@index([name])
}

model BloodDrive {
  id          String         @id @default(uuid())
  facilityId  String
  name        String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  targetUnits Int?
  capacity    Int?
  status      CampaignStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  facility      Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdBy     User?                  @relation("BloodDriveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  registrations CampaignRegistration[]

  @@index([facilityId])
  @@index([status])
  @@index([startsAt])
}

model CampaignRegistration {
  id             String             @id @default(uuid())
  campaignId     String
  donorProfileId String
  status         RegistrationStatus @default(CONFIRMED)
  registeredById String?
  checkedInAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  campaign     BloodDrive   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Restrict)
  registeredBy User?        @relation("RegistrationRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  donation     Donation?

  @@unique([campaignId, donorProfileId])
  @@index([donorProfileId])
  @@index([status])
}

model Donation {
  id                     String        @id @default(uuid())
  publicCode             String        @unique
  donorProfileId         String
  facilityId             String
  campaignRegistrationId String?       @unique
  state                  DonationState @default(SCHEDULED)
  scheduledFor           DateTime
  checkedInAt            DateTime?
  collectedAt            DateTime?
  volumeMl               Int?
  bloodGroup             BloodGroup?
  createdById            String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  donorProfile         DonorProfile?         @relation(fields: [donorProfileId], references: [id], onDelete: Restrict)
  facility             Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  campaignRegistration CampaignRegistration? @relation(fields: [campaignRegistrationId], references: [id], onDelete: Restrict)
  createdBy            User?                 @relation("DonationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  screening            DonationScreening?

  @@index([donorProfileId])
  @@index([facilityId])
  @@index([state])
  @@index([scheduledFor])
}

model DonationScreening {
  id           String          @id @default(uuid())
  donationId   String          @unique
  screenedById String
  bloodGroup   BloodGroup
  result       ScreeningResult @default(IN_PROGRESS)
  notes        String?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  donation   Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  screenedBy User     @relation("ScreeningScreenedBy", fields: [screenedById], references: [id], onDelete: Restrict)

  @@index([screenedById])
}

model DonorDeferral {
  id             String    @id @default(uuid())
  donorProfileId String
  reasonCode     String
  reasonNote     String?
  effectiveAt    DateTime  @default(now())
  expiresAt      DateTime?
  createdById    String
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("DeferralCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy   User?        @relation("DeferralResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([donorProfileId])
  @@index([effectiveAt])
}

enum RoleScope {
  GLOBAL
  FACILITY
}
