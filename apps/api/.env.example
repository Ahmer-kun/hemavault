NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgresql://blood_ops:blood_ops@localhost:5432/blood_ops?schema=public
WEB_ORIGIN=http://localhost:5173

# Session lifecycle (seconds unless noted)
SESSION_TTL_SECONDS=604800
SESSION_IDLE_SECONDS=3600
EMAIL_VERIFY_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Account lockout after repeated login failures
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Cookies: sent over HTTPS when true; keep false for local HTTP dev
COOKIE_SECURE=false